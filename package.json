{
  "name": "mi-organizador",
  "version": "1.0.0",
  "description": "Organizador personal: estudio, gimnasio, dieta, negocio 3D, calendario y tareas",
  "author": "Roa",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "dist:win": "vite build && electron-builder --win nsis --publish never",
    "cap:sync": "vite build && npx cap sync android"
  },
  "devDependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@tabler/icons": "^3.53.0",
    "chart.js": "^4.6.2",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.roa.organizador",
    "productName": "Organizador",
    "copyright": "Roa",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Organizador-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Organizador",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sanderz26",
        "repo": "Mi-organizador",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": "https://github.com/Sanderz26/Mi-organizador"
}
